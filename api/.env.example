NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=coac_heroes
DATABASE_USER=coac_heroes
DATABASE_PASSWORD=coac_heroes
DATABASE_SYNCHRONIZE=false
DATABASE_MIGRATIONS_RUN=false

# Must match the iOS bundle identifier; no Apple private key is needed for native ID-token verification.
APPLE_CLIENT_ID=com.yassansplus.coacheroes

# Server only. Generation stays unavailable until a key is configured.
OPENAI_API_KEY=
# Reasoning effort is high. Exercises use https://wger.de/api/v2/ (no self-hosting).

# Modèles par contexte : programme high, discussion medium, onboarding low
OPENAI_PROGRAM_MODEL=gpt-5.6-sol
OPENAI_REVIEW_MODEL=gpt-5.6-terra
OPENAI_ONBOARDING_MODEL=gpt-5.6-luna
OPENAI_NUTRITION_PLAN_MODEL=gpt-5.6-sol
OPENAI_NUTRITION_MEAL_MODEL=gpt-6-luna
OPENAI_NUTRITION_COACH_MODEL=gpt-5.6-terra
OPENAI_COACH_CHAT_MODEL=gpt-6-luna
# Facultatif : enrichit la recherche des aliments génériques. Clé serveur uniquement.
FOODDATA_CENTRAL_API_KEY=

# Daily reminders: the API must be running at 09:00 in each user's timezone.
DISABLE_DAILY_WORKER=false
# Optional: Expo push access security, server only. Leave empty when not enabled.
EXPO_ACCESS_TOKEN=
