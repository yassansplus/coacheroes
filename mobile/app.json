{
  "expo": {
    "name": "Coac Heroes",
    "slug": "coac-heroes",
    "version": "1.0.0",
    "scheme": "coac-heroes",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Autorise Coac Heroes à photographier ton repas dans l’application.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorise Coac Heroes à accéder aux photos que tu choisis pour suivre ton évolution.",
          "cameraPermission": "Autorise Coac Heroes à prendre une photo pour suivre ton évolution.",
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "271f7d30-577a-4a17-b697-54e98addbe85"
      }
    },
    "ios": {
      "bundleIdentifier": "com.yassansplus.coacheroes",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    }
  }
}
