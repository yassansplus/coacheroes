{
  "expo": {
    "name": "Coac Heroes",
    "slug": "coac-heroes",
    "version": "1.0.0",
    "icon": "./assets/app-icon/icon.png",
    "scheme": "coac-heroes",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080d38",
          "image": "./assets/app-icon/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Autorise Coac Heroes à photographier ton repas dans l’application.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorise Coac Heroes à accéder aux photos que tu choisis pour suivre ton évolution.",
          "cameraPermission": "Autorise Coac Heroes à prendre une photo pour suivre ton évolution.",
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-notifications",
      "./plugins/with-widget-fonts.cjs",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.yassansplus.coacheroes.widgets",
          "groupIdentifier": "group.com.yassansplus.coacheroes",
          "widgets": [
            {
              "name": "CoacHeroesToday",
              "displayName": "Coac Heroes",
              "description": "Tes calories, ta séance et ton Squad en un coup d’œil.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "271f7d30-577a-4a17-b697-54e98addbe85"
      }
    },
    "ios": {
      "bundleIdentifier": "com.yassansplus.coacheroes",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    }
  }
}
