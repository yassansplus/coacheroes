{
  "expo": {
    "name": "Coac Heroes",
    "slug": "coac-heroes",
    "version": "1.0.0",
    "scheme": "coac-heroes",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorise Coac Heroes à accéder aux photos que tu choisis pour suivre ton évolution.",
          "cameraPermission": "Autorise Coac Heroes à prendre une photo pour suivre ton évolution.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
